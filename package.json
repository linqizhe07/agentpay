{
  "name": "agentpay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "x402 payments for AI agents: a budgeted agent wallet (intent mandates, policy gate, durable ledger), payee middleware, a self-hostable facilitator and a CLI, built on the official @x402/* packages.",
  "workspaces": [
    "packages/core",
    "packages/contracts",
    "packages/facilitator",
    "packages/payee",
    "packages/wallet",
    "packages/cli",
    "demo"
  ],
  "scripts": {
    "typecheck": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen-abi": "npm run gen:abi --workspace @agentpay/contracts",
    "demo": "npm run gen-abi && npm run demo --workspace @agentpay/demo",
    "facilitator": "npm run start --workspace @agentpay/facilitator",
    "payee": "npm run start --workspace @agentpay/payee",
    "vendor-sim": "npm run vendor-sim --workspace @agentpay/payee",
    "cli": "tsx packages/cli/src/cli.ts",
    "deploy:local": "npm run deploy:local --workspace @agentpay/contracts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
