# ---- contracts: deploy scripts (packages/contracts/scripts/deploy-*.ts) ----
# Deployer EOA. For `deploy:local` this defaults to Hardhat dev account #0.
DEPLOYER_PK=0x...
# `deploy:base-sepolia` defaults to https://sepolia.base.org; `deploy:local` to http://127.0.0.1:8545
RPC_URL=https://sepolia.base.org
# Base Sepolia USDC (Circle testnet deployment). Local deploys mint their own MockUSDC.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Seconds a withdrawal stays locked. Must be >= the settlement processor's SETTLE_WINDOW.
WITHDRAW_DELAY=86400

# ---- settlement processor (packages/sp) ----
SP_PK=0x...
CHAIN_ID=84532
WALLET_ADDRESS=0x...
# Comma-separated ERC-20 addresses the SP settles.
SUPPORTED_TOKENS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SP_PORT=3001
# Append-only queue file, fsynced per enqueue. Default: packages/sp/data/sp-queue.jsonl (this path is
# the same file relative to packages/sp, where `npm run sp` runs). `:memory:` = no persistence at all.
STORE_PATH=./data/sp-queue.jsonl
# Seconds within which an enqueued mandate is settled on-chain.
SETTLE_WINDOW=10800
MIN_DEADLINE_MARGIN=120
MAX_DEADLINE_HORIZON=86400
BATCH_INTERVAL_MS=5000
BATCH_MAX=50
SEND_MARGIN=30
MAX_ATTEMPTS=8

# ---- payee example server (packages/payee/examples/express.ts) ----
PAYEE_PK=0x...
PAYEE_PORT=4021
SP_URL=http://127.0.0.1:3001
SP_ADDRESS=0x...

# ---- agent wallet CLI (packages/cli) ----
AGENTPAY_KEY=0x...
AGENTPAY_RPC=http://127.0.0.1:8545
AGENTPAY_WALLET=0x...
AGENTPAY_TOKEN=0x...
AGENTPAY_NETWORK=eip155:31337
# Comma-separated settlement processor addresses the wallet trusts (empty = trust the offer).
AGENTPAY_SP=
# Directory holding config.json, mandates.json and ledger.jsonl (default ~/.agentpay).
AGENTPAY_HOME=
