# ---- contracts: local deploy script (packages/contracts/scripts/deploy-local.ts) ----
# Deployer EOA; defaults to Hardhat dev account #0. Nothing is deployed on Base Sepolia:
# packages/contracts/deployments/base-sepolia.json is a static record of Circle's USDC.
DEPLOYER_PK=0x...
RPC_URL=http://127.0.0.1:8545

# ---- facilitator (packages/facilitator) ----
# Broadcasts settlements and pays their gas: needs ETH on the target chain.
FACILITATOR_PK=0x...
# CHAIN_ID, SUPPORTED_TOKENS and the token domain default to packages/contracts/deployments/${DEPLOYMENT:-localhost}.json
DEPLOYMENT=localhost
CHAIN_ID=84532
# Comma-separated EIP-3009 tokens this facilitator settles (anything else is refused before touching the chain).
SUPPORTED_TOKENS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_DOMAIN_NAME=USDC
USDC_DOMAIN_VERSION=2
# Comma-separated payTo allowlist. Unset = settle for anyone, which on a public network lets anyone spend this key's gas.
PAYEES=0x...
FACILITATOR_PORT=3001
HOST=127.0.0.1
# How long /settle waits for the receipt before answering settlement_pending (Base: ~2 s blocks).
RECEIPT_TIMEOUT_MS=30000
# When set, /verify and /settle require `authorization: Bearer <token>`.
FACILITATOR_AUTH_TOKEN=

# ---- payee example server (packages/payee/examples/express.ts) ----
# Where settlements go (an address, no key needed). Defaults to hardhat #2 on the local chain.
PAYEE_ADDRESS=0x...
PAYEE_PORT=4021
# Local: http://127.0.0.1:3001. Base Sepolia: https://x402.org/facilitator (the deployment record's default).
FACILITATOR_URL=http://127.0.0.1:3001
# Optional bearer token for a self-hosted facilitator that requires one.
# FACILITATOR_AUTH_TOKEN=
# NETWORK, USDC_ADDRESS, USDC_DOMAIN_NAME, USDC_DOMAIN_VERSION default to the deployment record.

# ---- agent wallet CLI (packages/cli) ----
# The payer key: it can move every USDC in its account. Keep a small float there.
AGENTPAY_KEY=0x...
# Needed by `balance` and `reconcile` only; `pay` signs offline. Defaults per network (hardhat / Base Sepolia).
AGENTPAY_RPC=http://127.0.0.1:8545
# Token + its EIP-712 domain; both default to the deployment record (init --from-deployment writes them to config.json).
AGENTPAY_TOKEN=0x...
AGENTPAY_TOKEN_NAME=
AGENTPAY_TOKEN_VERSION=
AGENTPAY_NETWORK=eip155:31337
# Directory holding config.json, mandates.json and ledger.jsonl (default ~/.agentpay).
AGENTPAY_HOME=
